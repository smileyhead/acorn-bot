<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RuntimeIdentifiers>linux-x64</RuntimeIdentifiers>
    </PropertyGroup>

    <ItemGroup>
        <None Remove="tock.txt"/>
    </ItemGroup>
    
    <ItemGroup>
        <PackageReference Include="Dangl.Calculator" Version="2.3.2" />
        <PackageReference Include="DSharpPlus" Version="5.0.0-nightly-02613" />
        <PackageReference Include="DSharpPlus.Commands" Version="5.0.0-nightly-02613" />
        <PackageReference Include="Microsoft.ClearScript.Core" Version="7.5.1.1" />
        <PackageReference Include="Microsoft.ClearScript.V8" Version="7.5.1.1" />
        <PackageReference Include="Tesseract" Version="5.2.0"/>
        <PackageReference Include="Tomlyn" Version="2.10.1" />
        <PackageReference Include="UnitsNet" Version="6.0.0-pre021" />
    </ItemGroup>

    <ItemGroup>
        <None Update="help.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Update="quotes.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Update="tessdata\eng.traineddata">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <ItemGroup>
        <Folder Include="tessdata\"/>
    </ItemGroup>

</Project>
